
    digraph G {
        graph [splines=true];
        node [fontname="Arial"];
        edge [penwidth=1.5];
    "__start__" [label="__start__", shape=ellipse, style=filled, fillcolor=lightblue, width=0.5, height=0.3];"__end__" [label="__end__", shape=ellipse, style=filled, fillcolor=lightblue, width=0.5, height=0.3];"judge" [label="judge", shape=box, style=filled, fillcolor=lightyellow, width=1.5, height=0.8];"joke_teller_1" [label="joke_teller_1", shape=ellipse, style=filled, fillcolor=lightgreen, width=0.5, height=0.3];"joke_teller_2" [label="joke_teller_2", shape=ellipse, style=filled, fillcolor=lightgreen, width=0.5, height=0.3];"print_joke" [label="print_joke", shape=ellipse, style=filled, fillcolor=lightgreen, width=0.5, height=0.3];"__start__" -> "judge";
        "judge" -> "joke_teller_1" [style=dotted, penwidth=1.5];
        "joke_teller_1" -> "judge" [style=dotted, penwidth=1.5];
        "judge" -> "joke_teller_2" [style=dotted, penwidth=1.5];
        "joke_teller_2" -> "judge" [style=dotted, penwidth=1.5];
        "judge" -> "print_joke" [style=dotted, penwidth=1.5];
        "print_joke" -> "judge" [style=dotted, penwidth=1.5];"judge" -> "__end__";}
